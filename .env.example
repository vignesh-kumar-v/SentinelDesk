# Judge endpoint. Ollama exposes an OpenAI-compatible API on /v1 and can route
# to hosted frontier models (":cloud" tags) with no separate provider key.
SD_JUDGE_BASE_URL=http://localhost:11434/v1
SD_JUDGE_API_KEY=ollama
SD_JUDGE_MODEL=deepseek-v4-pro:cloud

# Resolution-agent endpoint (vLLM in Phase 4; any OpenAI-compatible server before that)
SD_RESOLUTION_BASE_URL=http://localhost:8000/v1
SD_RESOLUTION_API_KEY=EMPTY

# Base model to fine-tune
SD_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Optional: Langfuse (Phase 7)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
